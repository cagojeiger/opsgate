              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterCredentialResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credential input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
